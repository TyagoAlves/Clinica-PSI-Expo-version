# ==============================================================================
# ARQUIVO DE EXEMPLO (.env.example) - BANCO SQLITE
# Copie para .env se necessário. O banco clinica.db é gerado automaticamente.
# ==============================================================================

# Endereço e porta onde o servidor Node.js local (src/banco/servidor.js) escuta o aplicativo
HOST=127.0.0.1
PORT=3333
CORS_ORIGINS=http://localhost:8081

# Caminho do arquivo de banco de dados SQLite (criado automaticamente na pasta data/)
DB_PATH=./data/clinica.db

# Login do sistema (usuário criado automaticamente na 1ª vez que o servidor sobe, se não existir nenhum)
# TROQUE a senha antes de usar com dados reais. Mudar aqui depois não altera um usuário já criado:
# para recriar, apague a pasta data/ (isso apaga também os pacientes e seções).
LOGIN_EMAIL=admin@clinica.com.br
LOGIN_SENHA=123456
# Por quantas horas o login vale antes de pedir a senha de novo
SESSAO_HORAS=12
