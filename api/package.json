{
  "name": "clinica-api",
  "version": "0.1.0",
  "private": true,
  "description": "API REST da Clínica Psi (scaffold inicial — Node.js + TypeScript + Express)",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:key": "tsx scripts/gen-key.ts",
    "load-test": "tsx scripts/load-test.ts",
    "db:reset": "node -e \"require('fs').rmSync('data',{recursive:true,force:true})\"",
    "rotate-key": "tsx --env-file-if-exists=.env scripts/rotate-key.ts"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/autocannon": "^7.12.7",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/supertest": "^6.0.3",
    "autocannon": "^8.0.0",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "~5.7.0",
    "vitest": "^3.2.7"
  }
}
