# Copie para .env e ajuste.
# 127.0.0.1 basta para o Emulador Android (ele acessa o host por 10.0.2.2).
# Use 0.0.0.0 só se for testar num celular físico na mesma rede (o Windows vai pedir liberação no firewall).
HOST=127.0.0.1
PORT=3333
# Origens liberadas no CORS (Expo web roda em 8081). Separe por vírgula.
CORS_ORIGINS=http://localhost:8081

# Banco PostgreSQL do Supabase: painel → Connect → Connection string → URI → Session pooler.
# Troque [YOUR-PASSWORD] pela senha do banco. NUNCA commitar este valor.
DATABASE_URL=postgresql://postgres.<projeto>:[YOUR-PASSWORD]@aws-0-<regiao>.pooler.supabase.com:5432/postgres

# Chave AES-256 dos campos clínicos sensíveis (32 bytes base64). Gere com: npm run gen:key
# NUNCA commitar a chave real; perder a chave = perder os dados cifrados.
DATA_ENCRYPTION_KEY=

# Validade do login, em dias.
SESSION_TTL_DAYS=30
# true se a API estiver atrás de proxy reverso (nginx, etc.)
TRUST_PROXY=false
